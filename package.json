{
  "name": "veilweaver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Svelte browser arena for practicing ranged damage and dodging.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "test:core": "node --test tests/engine.test.mjs tests/catalogue.test.mjs tests/readability.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:core && npm run test:ui",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.91",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "happy-dom": "^20.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
